; Import-direction contracts — §22.1 of ai-harness-python-architecture.md.
;
; Two forbidden edges are the whole point of this file:
;   1. no sideways imports between peer subgraphs — anything both need lives one layer down.
;      This is the rule that would have prevented the seven duplications of §3.14 before they
;      drifted.
;   2. orchestration.router must not import llm — the MECHANICAL guarantee that no LLM call
;      decides a workflow transition (§7 principle 1).

[importlinter]
root_package = ai_harness
include_external_packages = True

[importlinter:contract:layers]
name = Strictly downward layering
type = layers
;
; Refined in Phase 3, after the contract caught three violations that were not mistakes.
; §22.1 lists agents/quality and tools/policies/security as peers; the dependencies that
; actually exist are directional, and pretending otherwise would mean either weakening the
; contract or contorting the code:
;
;   * the triager reads gate logs and baselines, so quality sits BELOW agents. Nothing in
;     quality needs an agent — the one candidate, the flake adjudicator, is deliberately not
;     built (Q11: a confirmation re-run is deterministic evidence, and a model adds judgement
;     where evidence already exists);
;   * the tool broker's entire job is to consult policy and enforce containment before it
;     executes anything, so policies and security sit BELOW tools.
;
; Both directions are one-way and stay checked. A peer declaration would have made these
; imports legal in either direction, which is strictly less safety than this.
; Phase 6 splits cli and workers, which §22.1 lists as peers. The dependency is real and
; one-way: `agent work` and `agent tick` START a worker, and nothing in workers/ knows a CLI
; exists. `ai_harness.wiring` is deliberately outside every layer — a composition root imports
; everything by definition, and constraining it would only push the wiring somewhere that is
; constrained, i.e. somewhere worse.
layers =
    ai_harness.cli
    ai_harness.workers | ai_harness.scout
    ai_harness.orchestration
    ai_harness.subgraphs
    ai_harness.agents
    ai_harness.quality | ai_harness.workspace | ai_harness.deploy
    ai_harness.llm | ai_harness.context | ai_harness.tools
    ai_harness.policies | ai_harness.security
    ai_harness.providers | ai_harness.persistence | ai_harness.observability | ai_harness.product
    ai_harness.schemas
    ai_harness.kernel

[importlinter:contract:router-is-llm-free]
name = The router cannot reach an LLM
type = forbidden
source_modules =
    ai_harness.orchestration.router
    ai_harness.orchestration.transitions
forbidden_modules =
    ai_harness.llm
    ai_harness.agents
    ai_harness.providers

[importlinter:contract:subgraph-peers]
name = Peer subgraphs are independent
type = independence
modules =
    ai_harness.subgraphs.prepare
    ai_harness.subgraphs.analyse
    ai_harness.subgraphs.implement
    ai_harness.subgraphs.validate
    ai_harness.subgraphs.review
    ai_harness.subgraphs.integrate
    ai_harness.subgraphs.complete

[importlinter:contract:kernel-is-standalone]
name = The kernel imports nothing from the package
type = forbidden
source_modules =
    ai_harness.kernel
forbidden_modules =
    ai_harness.schemas
    ai_harness.providers
    ai_harness.llm
    ai_harness.orchestration

[importlinter:contract:structured-output-has-one-caller]
name = call_structured has exactly one caller
type = forbidden
; Direct imports only. A subgraph reaches call_structured *through* an agent by design — that
; is the layering. What must never happen is a subgraph building its own prompt and parsing its
; own output, which is a direct import of this module.
allow_indirect_imports = True
source_modules =
    ai_harness.subgraphs
    ai_harness.orchestration
    ai_harness.quality
    ai_harness.workspace
    ai_harness.cli
forbidden_modules =
    ai_harness.llm.structured

[importlinter:contract:scout-cannot-start-a-run]
name = The scout files issues and cannot start a run
; Q12: the scout is a SEPARATE SERVICE that shares kernel/, llm/ and providers/ and has its own
; lifecycle. The economics that make it worth running depend on its output being cheap to
; reject — a human reads a `proposed` issue and relabels it, or closes it. If the scout could
; reach the machine, a low-confidence finding would become an unattended code change and that
; property would be gone. So it is a contract, not a comment.
type = forbidden
source_modules =
    ai_harness.scout
forbidden_modules =
    ai_harness.orchestration
    ai_harness.subgraphs
    ai_harness.workers
    ai_harness.persistence
